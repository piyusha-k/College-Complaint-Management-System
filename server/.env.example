# Server Port & URLs
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=agentflow_super_secret_jwt_key_2026_operations_console
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=agentflow_aes256_credential_key_32_bytes_len!!

# Database & Queue (Leave empty for automatic in-memory zero-config fallback)
MONGODB_URI=
REDIS_URL=

# AI Provider API Keys (Optional: Falls back to deterministic rule builder if not supplied)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# OAuth & Webhook Credentials (Optional: Sandbox demo available out of the box)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/slack/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/discord/callback

GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/google-sheets/callback
